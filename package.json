{
  "name": "midnight-rollcall",
  "version": "0.5.0-dev.1",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "npm run build && node scripts/serve.mjs",
    "build": "node scripts/build.mjs",
    "test": "npm run build && node --test tests/*.test.mjs",
    "desktop": "npm run build && electron .",
    "dist": "npm run build && electron-builder --publish never",
    "typecheck": "tsc --noEmit",
    "test:desktop": "npm run build && node scripts/smoke-electron.mjs",
    "test:traverse": "npm run build && node scripts/traverse-electron.mjs",
    "dist:ci": "npm run build && electron-builder",
    "test:regression": "npm run build && node scripts/regression-electron.mjs",
    "test:audio": "npm run build && node scripts/audio-electron.mjs",
    "dist:web": "npm run build && python3 scripts/package-web.py",
    "test:hints": "npm run build && node scripts/hints-electron.mjs",
    "test:materials": "npm run build && node scripts/materials-electron.mjs",
    "test:settings": "npm run build && node scripts/settings-electron.mjs",
    "test:rendering": "npm run build && node scripts/rendering-electron.mjs",
    "test:hiding": "npm run build && node scripts/hiding-electron.mjs",
    "test:narrative": "npm run build && node scripts/narrative-electron.mjs",
    "test:panels": "npm run build && node scripts/panel-layout-electron.mjs",
    "test:defeat": "npm run build && node scripts/defeat-electron.mjs",
    "test:mix": "npm run build && node scripts/mix-electron.mjs"
  },
  "dependencies": {
    "three": "https://registry.npmjs.org/three/-/three-0.187.0.tgz"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/three": "0.187.0",
    "electron": "43.8.8",
    "electron-builder": "26.18.0",
    "typescript": "https://registry.npmjs.org/typescript/-/typescript-5.9.3.tgz",
    "vite": "8.3.8"
  },
  "build": {
    "appId": "org.midnightrollcall.game",
    "productName": "末铃点名",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.png"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "linux": {
      "target": [
        "AppImage",
        "tar.gz"
      ],
      "icon": "build/icon.png"
    },
    "artifactName": "midnight-rollcall-${version}-${os}-${arch}.${ext}",
    "nsis": {
      "artifactName": "midnight-rollcall-${version}-win-${arch}-setup.${ext}"
    },
    "portable": {
      "artifactName": "midnight-rollcall-${version}-win-${arch}-portable.${ext}"
    }
  },
  "license": "MIT",
  "description": "Original offline Chinese campus horror escape game",
  "author": "Midnight Rollcall contributors",
  "overrides": {
    "minimatch@>=7 <11.0.1": "11.0.3"
  }
}
